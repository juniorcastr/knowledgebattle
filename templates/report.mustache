<div class="mod-knowledgebattle-report">
<div class="knowledgebattle-report">
    <!-- Header Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">{{#str}}tpl_report_heading, mod_knowledgebattle{{/str}}</h3>
            <p class="text-muted mb-0">{{#str}}tpl_report_subheading, mod_knowledgebattle{{/str}}</p>
        </div>
        <div>
            <a href="report.php?id={{cmid}}&action=exportcsv" class="btn btn-outline-success mr-2">
                <i class="fa fa-download"></i> {{#str}}tpl_export_csv, mod_knowledgebattle{{/str}}
            </a>
            <a href="report.php?id={{cmid}}&action=regrade&sesskey={{sesskey}}" class="btn btn-outline-primary" onclick="return confirm('{{#str}}tpl_confirm_regrade, mod_knowledgebattle{{/str}}');">
                <i class="fa fa-refresh"></i> {{#str}}tpl_regrade, mod_knowledgebattle{{/str}}
            </a>
        </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-2 col-sm-4 mb-2">
            <div class="card text-center bg-light border-0 shadow-sm">
                <div class="card-body py-3">
                    <span class="text-muted small">{{#str}}tpl_total_battles, mod_knowledgebattle{{/str}}</span>
                    <h3 class="font-weight-bold text-primary mb-0">{{stats_summary.total_matches}}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 mb-2">
            <div class="card text-center bg-light border-0 shadow-sm">
                <div class="card-body py-3">
                    <span class="text-muted small">{{#str}}tpl_completed, mod_knowledgebattle{{/str}}</span>
                    <h3 class="font-weight-bold text-success mb-0">{{stats_summary.completed_matches}}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 mb-2">
            <div class="card text-center bg-light border-0 shadow-sm">
                <div class="card-body py-3">
                    <span class="text-muted small">{{#str}}tpl_wo_inactivity, mod_knowledgebattle{{/str}}</span>
                    <h3 class="font-weight-bold text-danger mb-0">{{stats_summary.wo_matches}}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 mb-2">
            <div class="card text-center bg-light border-0 shadow-sm">
                <div class="card-body py-3">
                    <span class="text-muted small">{{#str}}tpl_direct_challenges, mod_knowledgebattle{{/str}}</span>
                    <h3 class="font-weight-bold text-info mb-0">{{stats_summary.direct_matches}}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 mb-2">
            <div class="card text-center bg-light border-0 shadow-sm">
                <div class="card-body py-3">
                    <span class="text-muted small">{{#str}}tpl_quick_battles, mod_knowledgebattle{{/str}}</span>
                    <h3 class="font-weight-bold text-secondary mb-0">{{stats_summary.mm_matches}}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 mb-2">
            <div class="card text-center bg-light border-0 shadow-sm">
                <div class="card-body py-3">
                    <span class="text-muted small">{{#str}}tpl_ai_master_bot, mod_knowledgebattle{{/str}}</span>
                    <h3 class="font-weight-bold text-dark mb-0">{{stats_summary.bot_matches}}</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Pedagogical Diagnostic: Question Accuracy -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white font-weight-bold d-flex justify-content-between align-items-center">
            <span><i class="fa fa-lightbulb-o text-warning mr-1"></i> {{#str}}tpl_diag_title, mod_knowledgebattle{{/str}}</span>
            <span class="badge badge-info">{{#str}}tpl_review_focus, mod_knowledgebattle{{/str}}</span>
        </div>
        <div class="card-body p-0">
            {{#has_questions}}
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 50%;">{{#str}}tpl_question_statement, mod_knowledgebattle{{/str}}</th>
                            <th>{{#str}}tpl_difficulty, mod_knowledgebattle{{/str}}</th>
                            <th class="text-center">{{#str}}tpl_answers, mod_knowledgebattle{{/str}}</th>
                            <th class="text-center">{{#str}}tpl_correct_count, mod_knowledgebattle{{/str}}</th>
                            <th style="width: 25%;">{{#str}}tpl_accuracy_rate, mod_knowledgebattle{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#questions_analytics}}
                        <tr class="{{#is_critical}}table-warning{{/is_critical}}">
                            <td>
                                <strong>{{question_text}}</strong>
                                {{#is_critical}}
                                <div class="text-danger small font-weight-bold mt-1">
                                    <i class="fa fa-exclamation-triangle"></i> {{#str}}tpl_pedagogical_warning, mod_knowledgebattle{{/str}}
                                </div>
                                {{/is_critical}}
                            </td>
                            <td><span class="badge badge-secondary">{{difficulty}}</span></td>
                            <td class="text-center">{{total_answers}}</td>
                            <td class="text-center">{{correct_answers}}</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1 mr-2" style="height: 12px;">
                                        <div class="progress-bar {{#is_critical}}bg-danger{{/is_critical}}{{^is_critical}}bg-success{{/is_critical}}"
                                             role="progressbar" style="width: {{accuracy_pct}}%;"></div>
                                    </div>
                                    <span class="font-weight-bold small">{{accuracy_pct}}%</span>
                                </div>
                            </td>
                        </tr>
                        {{/questions_analytics}}
                    </tbody>
                </table>
            </div>
            {{/has_questions}}
            {{^has_questions}}
            <div class="p-4 text-center text-muted">{{#str}}tpl_no_answers, mod_knowledgebattle{{/str}}</div>
            {{/has_questions}}
        </div>
    </div>

    <!-- Student Performance Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-white font-weight-bold">
            <i class="fa fa-users text-primary mr-1"></i> {{#str}}tpl_student_performance, mod_knowledgebattle, {{stats_summary.total_students}}{{/str}}
        </div>
        <div class="card-body p-0">
            {{#has_students}}
            <div class="table-responsive">
                <table class="table table-hover text-center align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>{{#str}}tpl_rank_position, mod_knowledgebattle{{/str}}</th>
                            <th class="text-left">{{#str}}tpl_student, mod_knowledgebattle{{/str}}</th>
                            <th>{{#str}}tpl_score, mod_knowledgebattle{{/str}}</th>
                            <th>{{#str}}tpl_battles, mod_knowledgebattle{{/str}}</th>
                            <th>{{#str}}tpl_wins, mod_knowledgebattle{{/str}}</th>
                            <th>{{#str}}tpl_losses, mod_knowledgebattle{{/str}}</th>
                            <th>{{#str}}tpl_win_rate, mod_knowledgebattle{{/str}}</th>
                            <th>{{#str}}tpl_streak_full, mod_knowledgebattle{{/str}}</th>
                            <th>{{#str}}tpl_gradebook_grade, mod_knowledgebattle{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#students_list}}
                        <tr>
                            <td><span class="badge badge-pill badge-primary">#{{rank}}</span></td>
                            <td class="text-left">
                                <div class="font-weight-bold">{{fullname}}</div>
                                <div class="text-muted small">{{email}}</div>
                            </td>
                            <td class="font-weight-bold text-primary">{{#str}}tpl_pts, mod_knowledgebattle, {{points}}{{/str}}</td>
                            <td>{{matches_played}}</td>
                            <td class="text-success">{{wins}}</td>
                            <td class="text-danger">{{losses}}</td>
                            <td>{{win_rate}}</td>
                            <td>{{current_streak}} 🔥 <span class="text-muted small">({{#str}}tpl_max, mod_knowledgebattle, {{max_streak}}{{/str}})</span></td>
                            <td class="font-weight-bold h5 text-success mb-0">{{grade}}</td>
                        </tr>
                        {{/students_list}}
                    </tbody>
                </table>
            </div>
            {{/has_students}}
            {{^has_students}}
            <div class="p-4 text-center text-muted">{{#str}}tpl_no_students, mod_knowledgebattle{{/str}}</div>
            {{/has_students}}
        </div>
    </div>
</div>
</div>
{{#view_url}}<div class="text-center"><a href="{{view_url}}" class="btn btn-secondary mt-4">&larr; {{#str}}code_back_to_activity, mod_knowledgebattle{{/str}}</a></div>{{/view_url}}
