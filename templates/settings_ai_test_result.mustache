{{!
    @template mod_knowledgebattle/settings_ai_test_result

    Result box displayed after testing the AI provider connection.

    Context variables required for this template:
    * state - One of testing, success or failed
    * title - Heading text
    * provider, model - Tested provider and model
    * providerlabel, modellabel, latencylabel, replylabel - Field labels
    * latency - Latency in milliseconds (optional)
    * reply - Short reply from the provider (optional)
    * error - Error text (optional)

    Example context (json):
    {
        "success": true,
        "title": "Connection successful!",
        "provider": "OpenAI",
        "model": "gpt-4o-mini",
        "latency": 420,
        "providerlabel": "Provider",
        "modellabel": "Model",
        "latencylabel": "Latency",
        "replylabel": "Reply",
        "reply": "ok"
    }
}}
<div class="alert {{#testing}}alert-info{{/testing}}{{#success}}alert-success{{/success}}{{#failed}}alert-danger{{/failed}} py-2 mb-0">
    <strong>
        {{#testing}}<i class="fa fa-spinner fa-spin me-1" aria-hidden="true"></i>{{/testing}}
        {{#success}}<i class="fa fa-check-circle me-1" aria-hidden="true"></i>{{/success}}
        {{#failed}}<i class="fa fa-exclamation-triangle me-1" aria-hidden="true"></i>{{/failed}}
        {{title}}
    </strong>
    {{#error}}<div class="mt-1">{{error}}</div>{{/error}}
    <div class="mt-1 small">
        {{providerlabel}}: <span class="badge bg-primary text-white">{{provider}}</span>
        {{modellabel}}: <span class="badge bg-secondary text-white">{{model}}</span>
        {{#latency}}{{latencylabel}}: <span class="badge bg-info text-white">{{latency}} ms</span>{{/latency}}
    </div>
    {{#reply}}<div class="mt-1 small text-muted fst-italic">{{replylabel}}: "{{reply}}"</div>{{/reply}}
</div>
