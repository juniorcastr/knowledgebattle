{{!
    @template mod_knowledgebattle/settings_ai_test

    Button used on the plugin settings page to test the AI provider connection.

    Context variables required for this template:
    * buttonlabel - Text of the button
    * description - Help text displayed below the button

    Example context (json):
    {
        "buttonlabel": "Test Connection to Model & Provider",
        "description": "Click to verify connectivity with the selected AI provider."
    }
}}
<div class="py-1">
    <button type="button" class="btn btn-outline-primary" id="kb-btn-test-ai">
        <i class="fa fa-plug me-1" aria-hidden="true"></i> {{buttonlabel}}
    </button>
    <div class="form-text text-muted mt-1">{{description}}</div>
    <div id="kb-test-ai-result" class="mt-2 d-none" role="status" aria-live="polite"></div>
</div>
